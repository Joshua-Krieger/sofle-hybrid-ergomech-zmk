#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/ext_power.h>

#define BASE 0
#define SYMBOLS 1
#define NUMBER 2
#define ARROW 3
#define FUNCTION 4

/ {

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "default";
// ------------------------------------------------------------------------------------------------------------
// |  DEL  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   | ALTGR |
// |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BSLH  |
// |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
// | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  |       |  N   |  M    |  ,    |  .   |   /   | SHIFT |
// Final row: Function | ( | ) | Number | Left Alt | Backspace | Enter | Space / hold Arrow | Win | [ | ] | Function
            bindings = <
&kp DEL   &kp N1 &kp N2   &kp N3   &kp N4    &kp N5                           &kp N6 &kp N7    &kp N8    &kp N9   &kp N0   &kp RALT
&kp ESC   &kp Q  &kp W    &kp E    &kp R     &kp T                            &kp Y  &kp U     &kp I     &kp O    &kp P    &kp BSLH
&kp TAB   &kp A  &kp S    &kp D    &kp F     &kp G                            &kp H  &kp J     &kp K     &kp L    &kp SEMI &kp SQT
// V and M: tap for the letter, hold for Symbols.
&kp LSHFT &mt LCTRL Z &kp X &kp C &lt SYMBOLS V &kp B                       &kp N &lt SYMBOLS M &kp COMMA &kp DOT &mt RCTRL FSLH &kp RSHFT
&mo FUNCTION &kp LPAR &kp RPAR &mo NUMBER &kp LALT &kp BSPC    &kp RET &lt ARROW SPACE &kp LGUI &kp LBKT &kp RBKT &mo FUNCTION
            >;

        };

        symbols_layer {
            label = "symbols";
            bindings = <
&trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
&trans &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT    &kp CARET &kp AMPS &kp ASTRK &kp GRAVE &trans &trans
&trans &trans &kp EQUAL &trans &trans &trans    &trans &kp LPAR &kp RPAR &trans &trans &trans
&trans &trans &kp PLUS &trans &trans &trans    &trans &kp UNDER &kp MINUS &trans &trans &trans
&trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
            >;
        };

        number_layer {
            label = "number";
            bindings = <
&trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans    &trans &kp N7 &kp N8 &kp N9 &trans &trans
&trans &trans &trans &trans &trans &trans    &trans &kp N4 &kp N5 &kp N6 &trans &trans
&trans &trans &trans &trans &trans &trans    &trans &kp N1 &kp N2 &kp N3 &trans &trans
&trans &trans &trans &trans &trans &trans    &kp DOT &kp N0 &kp COMMA &trans &trans &trans
            >;
        };

        arrow_layer {
            label = "arrow";
            bindings = <
&trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans    &kp HOME &kp PG_UP &kp PG_DN &kp END &trans &trans
&trans &trans &trans &trans &trans &trans    &kp LEFT &kp DOWN &kp UP &kp RIGHT &trans &trans
&trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
            >;
        };

        function_layer {
            label = "function";
            bindings = <
&kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6    &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12
&studio_unlock &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
            >;
        };


    };
};
